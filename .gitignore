repos/

# ---- 2. 大体积 / 可再生成 / 非版本化内容 ----
backups/
env/
.claude/
.hermes/
.local/
.firecrawl/
data/vectordb/
data/_system/
projects/github-tools/drafts/

# ---- 3. 缓存、临时与运行时产物 ----
tmp/
cache/
.pytest-cache/
__pycache__/
*.pyc
*.pyo
node_modules/
*.log
Thumbs.db
desktop.ini
.DS_Store

# ---- 4. 凭证/密钥类(防 git add -A 误吞外泄;2026-09-16 加) ----
# 大仓自动 push 到 GitHub,真源里出现任何密钥都会在 23:00 被带走
.env
.env.*
*.env
*.key
*.pem
auth.json
credentials*
*token*.json
