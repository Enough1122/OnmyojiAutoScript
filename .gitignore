# ============================================================
# D:/Hermes 工作空间 —— 大仓排除清单
# 原则:大仓只管"应该被版本控制、且没有自己 remote"的内容。
# ============================================================

# ---- 1. 独立 git 仓库(>100M,或第三方克隆)----
# 2026-09-16 起外部/独立仓统一放 repos/(整夹一条排除;新克隆丢进去即可,无需改本文件)
repos/
# 2026-09-22:PR 审阅农场临时 worktree,同属独立 git 内容,整夹排除
scratch-wt/

# ---- 2. 大体积 / 可再生成 / 非版本化内容 ----
backups/
env/
.claude/
.hermes/
.local/
.firecrawl/
# 2026-09-17:data/ 整夹出库(mx_data 外拉快照 + vectordb + _system,均可再生成;/ 锚定顶层,不吞深层同名目录)
/data/
projects/github-tools/drafts/

# ---- 3. 缓存、临时与运行时产物 ----
tmp/
cache/
# 2026-09-26:PR 审阅/验证 worker 的临时 checkout 农场。
# 这些目录里含嵌套 .git 且部分 worktree 未 checkout commit,
# `git add -A` 会以 "does not have a commit checked out" (exit 128) 整批失败,
# 曾导致 23:00 自动备份静默空跑。一律锚定仓库根,不吞深层同名目录。
# 注意:以下不写结尾 "/",因为 worker 既落整目录也平铺单文件
# (cache-review-pr121614-live-pr.json / review-pr122061-guards.py 等);
# 前导 "/" 保证只锚定仓库根,深层 projects/cache-review-*/ 不受影响。
/cache-review-*
/review-pr*
/verify12*
/tmp-pr*
/review-cache-*
/cache-wt-*
/cache-scratch-*
/.scratch-tag-probe
/.scratch-probe-*
# worker 平铺到根目录的上游源码副本(agent/xxx.py.121757 形式:PR 号后缀)
/*.12[0-9][0-9][0-9][0-9]
.pytest-cache/
__pycache__/
*.pyc
*.pyo
node_modules/
*.log
*.bak
*.bak-*
projects/华通/data/*cache*.json
Thumbs.db
desktop.ini
.DS_Store

# ---- 4. 凭证/密钥类(防 git add -A 误吞外泄;2026-09-16 加) ----
# 大仓自动 push 到 GitHub,真源里出现任何密钥都会在 23:00 被带走
.env
.env.*
*.env
*.key
*.pem
auth.json
credentials*
*token*.json
