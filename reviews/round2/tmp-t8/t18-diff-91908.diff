+def _safe_relay_name(value) -> str | None:
+    import re
+
+    if not isinstance(value, str) or not value or len(value) > 255:
+        return None
+    if re.search(r"[\x00-\x1f\x7f\\/:]", value) or value in {".", ".."}:
