+    for order, attachment in enumerate(attachments):
+        keys = set(attachment) if isinstance(attachment, dict) else set()
+        allowed = _EXACT_ATTACHMENT_KEYS | {"refText"}
+        if not _EXACT_ATTACHMENT_KEYS <= keys or not keys <= allowed:
