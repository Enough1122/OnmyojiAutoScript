+      // never reach the nested string.
+      const errMsg =
+        (typeof body.error?.message === "string" ? body.error.message : undefined) ??
+        (typeof body.message === "string" ? body.message : undefined) ??
+        (typeof body.error === "string" ? body.error : undefined)
