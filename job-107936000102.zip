2026-09-25T04:01:02.6230953Z 
2026-09-25T04:01:02.6231052Z     @pytest.mark.platforms("posix")
2026-09-25T04:01:02.6231317Z     @pytest.mark.parametrize("create", [True, False])
2026-09-25T04:01:02.6231719Z     def test_sync_migrates_old_store_wrapper_before_python_collection(tmp_path, monkeypatch, create):
2026-09-25T04:01:02.6232088Z         import builtins
2026-09-25T04:01:02.6232284Z     
2026-09-25T04:01:02.6232490Z         from hermes_cli.venv_sync import publish_launchers
2026-09-25T04:01:02.6232808Z     
2026-09-25T04:01:02.6233042Z         repo, home, interpreter = fixture_tree(tmp_path, monkeypatch)
2026-09-25T04:01:02.6233370Z         monkeypatch.setattr(Path, "home", lambda: home)
2026-09-25T04:01:02.6233644Z         site = site_packages(repo / "venv")
2026-09-25T04:01:02.6233889Z         site.mkdir(parents=True)
2026-09-25T04:01:02.6234189Z         (site / "selected_probe.py").write_text("VALUE = 'ready'\n", encoding="utf-8")
2026-09-25T04:01:02.6234517Z         out = home / ".local/bin"
2026-09-25T04:01:02.6234733Z         out.mkdir(parents=True)
2026-09-25T04:01:02.6234939Z         if not create:
2026-09-25T04:01:02.6235152Z             original_import = builtins.__import__
2026-09-25T04:01:02.6235380Z     
2026-09-25T04:01:02.6235575Z             def without_config(name, *args, **kwargs):
2026-09-25T04:01:02.6235945Z                 assert name != "hermes_cli.config", "bootstrap publication imported application config"
2026-09-25T04:01:02.6236325Z                 return original_import(name, *args, **kwargs)
2026-09-25T04:01:02.6236563Z     
2026-09-25T04:01:02.6236797Z             monkeypatch.setattr(builtins, "__import__", without_config)
2026-09-25T04:01:02.6237085Z         store = home / "tools"
2026-09-25T04:01:02.6237317Z         for version in ("python-A", "python-B"):
2026-09-25T04:01:02.6237631Z             python = store / version / "bin/python3"
2026-09-25T04:01:02.6237903Z             python.parent.mkdir(parents=True)
2026-09-25T04:01:02.6238158Z             python.symlink_to(interpreter)
2026-09-25T04:01:02.6238582Z             (store / "facts.json").write_text(json.dumps({"schema": 1, "packages": {"python": {"entry": version}}}), encoding="utf-8")
2026-09-25T04:01:02.6239011Z             if version == "python-A":
2026-09-25T04:01:02.6239308Z                 _launchers.mint_launcher("hermes", repo, out, python, None)
2026-09-25T04:01:02.6239595Z             else:
2026-09-25T04:01:02.6239777Z                 if create:
2026-09-25T04:01:02.6239983Z                     publish_launchers(repo)
2026-09-25T04:01:02.6240213Z                 else:
2026-09-25T04:01:02.6240432Z                     publish_launchers(repo, create=False)
2026-09-25T04:01:02.6240719Z                     assert set(out.iterdir()) == {out / "hermes"}
2026-09-25T04:01:02.6241001Z                     assert not (home / "bin").exists()
2026-09-25T04:01:02.6241277Z                     assert not (home / "config.yaml").exists()
2026-09-25T04:01:02.6241548Z                     assert not (home / "skills").exists()
2026-09-25T04:01:02.6241803Z         shutil.rmtree(store / "python-A")
2026-09-25T04:01:02.6242087Z         result = subprocess.run([str(out / "hermes")], cwd=tmp_path,
2026-09-25T04:01:02.6242456Z                                 capture_output=True, text=True, timeout=30, encoding="utf-8")
2026-09-25T04:01:02.6242861Z >       assert result.returncode == 7, result.stderr
2026-09-25T04:01:02.6243156Z E       AssertionError: Traceback (most recent call last):
